<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>{{ product_name }} — ACL Control</title>
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/app.js" defer></script>
</head>
<body data-page="acl">
<header class="mobile-topbar">
  <a class="brand" href="/"><img class="brand-mark-img" src="/static/img/logo-mark.png" width="40" height="40" alt="" aria-hidden="true" decoding="async"><span class="brand-text">Kraken<span>Waf</span></span></a>
  <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-label="Open navigation">☰</button>
</header>
<div class="shell">
  <aside class="sidebar" aria-label="Primary navigation">
    <a class="brand" href="/"><img class="brand-mark-img" src="/static/img/logo-mark.png" width="40" height="40" alt="" aria-hidden="true" decoding="async"><span class="brand-text">Kraken<span>Waf</span></span></a>
    <nav class="nav">
      <div class="nav-section"><a class="nav-link" href="/dashboard"><span class="nav-icon" aria-hidden="true">▦</span><strong>Dashboard</strong></a></div>
      <div class="nav-section"><button class="nav-trigger active" type="button" data-accordion aria-expanded="true" aria-controls="acl-menu"><span class="nav-icon" aria-hidden="true">⬡</span><strong>ACL control</strong><span class="chevron" aria-hidden="true">⌄</span></button><div class="submenu" id="acl-menu"><a href="/acl/users">Users</a><a href="/acl/users/add">Add user</a><a href="/acl/users/delete">Delete user</a></div></div>
      <div class="nav-section"><button class="nav-trigger" type="button" data-accordion aria-expanded="true" aria-controls="logs-menu"><span class="nav-icon" aria-hidden="true">▤</span><strong>logs</strong><span class="chevron" aria-hidden="true">⌄</span></button><div class="submenu" id="logs-menu"><a href="/attacks">attacks</a><a href="/dashboard#requests">requests</a><a href="/dashboard#audit">audit</a></div></div>
      <div class="nav-section"><button class="nav-trigger" type="button" data-accordion aria-expanded="true" aria-controls="rules-menu"><span class="nav-icon" aria-hidden="true">&lt;&gt;</span><strong>rules</strong><span class="chevron" aria-hidden="true">⌄</span></button><div class="submenu" id="rules-menu"><a href="/dashboard#managed-rules">managed rules</a><a href="/dashboard#custom-rules">custom rules</a><a href="/dashboard#regex-rules">regex rules</a></div></div>
      <div class="nav-section"><a class="nav-link" href="/login"><span class="nav-icon" aria-hidden="true">⏻</span><strong>logout</strong></a></div>
    </nav>
  </aside>
  <main class="content acl-content">
    <section class="page-hero compact-hero">
      <span class="badge">Admin ACL Console</span>
      <h1>ACL control and user administration</h1>
      <p class="lead">Manage admin, operator, and auditor identities using local forms, strict CSP, and server-side validation hooks.</p>
    </section>
    <section class="acl-grid" aria-label="ACL actions">
      <a class="action-card" href="/acl/users/add"><span aria-hidden="true">＋</span><h2>Add user</h2><p>Create admin, operator, or auditor users.</p></a>
      <a class="action-card" href="/acl/users"><span aria-hidden="true">▦</span><h2>Show users</h2><p>DataTables-style pagination, Ajax, search, edit and delete actions.</p></a>
      <a class="action-card" href="/acl/users/delete"><span aria-hidden="true">×</span><h2>Delete user</h2><p>Remove users by ID or e-mail after backend confirmation.</p></a>
      <a class="action-card" href="/operator/update"><span aria-hidden="true">◉</span><h2>Operator update</h2><p>Self-service email or password update for operators.</p></a>
      <a class="action-card" href="/auditor/update"><span aria-hidden="true">◎</span><h2>Auditor update</h2><p>Self-service email or password update for auditors.</p></a>
      <a class="action-card" href="/attacks"><span aria-hidden="true">⌕</span><h2>Show attacks</h2><p>Search WAF events and open evidence in a new tab.</p></a>
    </section>
  </main>
</div>
</body>
</html>
