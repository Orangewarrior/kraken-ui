<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>{{ product_name }} — Users</title>
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/app.js" defer></script>
</head>
<body data-page="users">
<header class="mobile-topbar"><a class="brand" href="/"><img class="brand-mark-img" src="/static/img/logo-mark.png" width="40" height="40" alt="" aria-hidden="true" decoding="async"><span class="brand-text">Kraken<span>Waf</span></span></a><button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-label="Open navigation">☰</button></header>
<div class="shell"><aside class="sidebar" aria-label="Primary navigation"><a class="brand" href="/"><img class="brand-mark-img" src="/static/img/logo-mark.png" width="40" height="40" alt="" aria-hidden="true" decoding="async"><span class="brand-text">Kraken<span>Waf</span></span></a><nav class="nav"><div class="nav-section"><a class="nav-link" href="/dashboard"><span class="nav-icon" aria-hidden="true">▦</span><strong>Dashboard</strong></a></div><div class="nav-section"><button class="nav-trigger active" type="button" data-accordion aria-expanded="true" aria-controls="acl-menu"><span class="nav-icon" aria-hidden="true">⬡</span><strong>ACL control</strong><span class="chevron" aria-hidden="true">⌄</span></button><div class="submenu" id="acl-menu"><a href="/acl/users">Users</a><a href="/acl/users/add">Add user</a><a href="/acl/users/delete">Delete user</a></div></div><div class="nav-section"><a class="nav-link" href="/attacks"><span class="nav-icon" aria-hidden="true">⌕</span><strong>attacks</strong></a></div><div class="nav-section"><a class="nav-link" href="/login"><span class="nav-icon" aria-hidden="true">⏻</span><strong>logout</strong></a></div></nav></aside>
<main class="content table-page"><section class="page-hero compact-hero"><span class="badge">ACL Users</span><h1>User database</h1><p class="lead">Search by username, e-mail, or ID. Pagination is loaded by Ajax using a DataTables-style JSON contract.</p></section>
<section class="table-card" aria-labelledby="users-title"><div class="table-toolbar"><div><h2 id="users-title">Users</h2><p>Server-side endpoint: <code>/api/users</code></p></div><label class="table-search"><span>Search name or ID</span><input type="search" data-kw-table-search="users-table" placeholder="username, email or ID" autocomplete="off"></label></div><div class="table-scroll"><table id="users-table" class="kw-table" data-kw-table data-table-kind="users" data-ajax-url="/api/users" data-server-side="true" data-page-size="8"><thead><tr><th>ID</th><th>Username</th><th>E-mail</th><th>Type</th><th>Status</th><th>Created</th><th>Edit</th><th>Delete</th></tr></thead><tbody></tbody></table></div><div class="table-footer"><button type="button" class="ghost-button" data-kw-table-prev="users-table">Previous</button><span data-kw-table-info="users-table">Loading…</span><button type="button" class="ghost-button" data-kw-table-next="users-table">Next</button></div></section></main></div></body></html>
