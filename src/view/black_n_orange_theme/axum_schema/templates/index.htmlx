<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>{{ product_name }} — Web Application Defense</title>
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/app.js" defer></script>
</head>
<body data-page="index">
<header class="mobile-topbar">
  <a class="brand" href="/">
    <img class="brand-mark-img" src="static/img/logo-mark.png" width="40" height="40" alt="" aria-hidden="true" decoding="async">
    <span class="brand-text">Kraken<span>Waf</span></span>
  </a>
  <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-label="Open navigation">☰</button>
</header>
<div class="shell">
<aside class="sidebar" aria-label="Primary navigation">
  <a class="brand" href="/">
    <img class="brand-mark-img" src="static/img/logo-mark.png" width="40" height="40" alt="" aria-hidden="true" decoding="async">
    <span class="brand-text">Kraken<span>Waf</span></span>
  </a>

  <nav class="nav">
    <div class="nav-section">
      <a class="nav-link active" href="/dashboard">
        <span class="nav-icon" aria-hidden="true">▦</span>
        <strong>Dashboard</strong>
      </a>
    </div>

    <div class="nav-section">
      <button class="nav-trigger" type="button" data-accordion aria-expanded="true" aria-controls="acl-menu">
        <span class="nav-icon" aria-hidden="true">⬡</span>
        <strong>ACL control</strong>
        <span class="chevron" aria-hidden="true">⌄</span>
      </button>
      <div class="submenu" id="acl-menu">
        <a href="#acl-allowlist">IP allowlist</a>
        <a href="#acl-blocklist">IP blocklist</a>
        <a href="#rate-limits">rate limits</a>
      </div>
    </div>

    <div class="nav-section">
      <button class="nav-trigger" type="button" data-accordion aria-expanded="true" aria-controls="logs-menu">
        <span class="nav-icon" aria-hidden="true">▤</span>
        <strong>logs</strong>
        <span class="chevron" aria-hidden="true">⌄</span>
      </button>
      <div class="submenu" id="logs-menu">
        <a href="#alerts">alerts</a>
        <a href="#requests">requests</a>
        <a href="#audit">audit</a>
      </div>
    </div>

    <div class="nav-section">
      <button class="nav-trigger" type="button" data-accordion aria-expanded="true" aria-controls="rules-menu">
        <span class="nav-icon" aria-hidden="true">&lt;&gt;</span>
        <strong>rules</strong>
        <span class="chevron" aria-hidden="true">⌄</span>
      </button>
      <div class="submenu" id="rules-menu">
        <a href="#managed-rules">managed rules</a>
        <a href="#custom-rules">custom rules</a>
        <a href="#regex-rules">regex rules</a>
      </div>
    </div>

    <div class="nav-section">
      <a class="nav-link" href="/login">
        <span class="nav-icon" aria-hidden="true">⏻</span>
        <strong>logout</strong>
      </a>
    </div>
  </nav>

  <section class="status-card" aria-label="System status">
    <span class="nav-icon" aria-hidden="true">⬡</span>
    <span>System Status</span>
    <strong>Secure</strong>
    <small>All systems operational</small>
  </section>

  <div class="sidebar-footer">
    <span>© 2026 KrakenWaf</span>
    <span>v1.0.0</span>
  </div>
</aside>
  <main class="page">
    <section class="hero-grid" aria-labelledby="hero-title">
      <div class="hero">
        <div class="hero-content">
          <span class="badge">Real-time Protection Active</span>
          <h1 id="hero-title">Protect apps with <span class="accent">real-time web application defense</span></h1>
          <p class="lead">{{ product_name }} inspects every request, enforces intelligent rules, manages ACLs, and delivers deep observability to keep your applications secure.</p>
          <div class="cta-row">
            <a class="cta" href="/dashboard">⬡ Get Protected Now →</a>
            <a class="ghost-button" href="#features">View features</a>
          </div>
        </div>
        <img class="hero-kraken-img" src="static/img/kraken-hero.png" width="900" height="900" alt="" aria-hidden="true" loading="lazy" decoding="async">
      </div>

      <aside class="preview-card" aria-label="Dashboard preview">
        <div class="preview-head">
          <h2>{{ product_name }} Dashboard <span class="accent">(Preview)</span></h2>
          <span class="badge">ON</span>
        </div>
        <figure class="dashboard-screenshot" aria-label="Local PNG dashboard preview">
          <img src="static/img/dashboard-preview.png" width="1200" height="1282" alt="KrakenWaf dashboard preview with traffic metrics, threat categories, recent alerts and live request logs" loading="lazy" decoding="async">
          <figcaption>Local PNG preview asset from <code>static/img/dashboard-preview.png</code></figcaption>
        </figure>
        <div class="preview-inner">
          <div class="kpi-grid">
            {% for metric in metrics %}
            <article class="metric-card">
              <h3>{{ metric.title }}</h3>
              <div class="metric-value">
                <strong>{{ metric.value }}</strong>
                {% if metric.negative %}
                <span class="negative">{{ metric.delta }}</span>
                {% else %}
                <span>{{ metric.delta }}</span>
                {% endif %}
              </div>
              <div class="mini-chart" data-chart="{{ metric.chart_key }}"></div>
            </article>
            {% endfor %}
          </div>

          <div class="dashboard-grid">
            <section class="panel">
              <div class="panel-head">
                <h3>Traffic Over Time</h3>
                <small>Last 24 hours</small>
              </div>
              <div class="chart" data-chart="overview"></div>
            </section>

            <section class="panel">
              <h3>Threat Categories</h3>
              <div class="donut-wrap">
                <div class="donut" data-label="24.6K&#10;Blocked" aria-hidden="true"></div>
                <div class="legend" aria-label="Threat category legend">
                  <span class="legend-row"><span>SQLi</span><strong>36%</strong></span>
                  <span class="legend-row"><span>XSS</span><strong>25%</strong></span>
                  <span class="legend-row"><span>LFI</span><strong>15%</strong></span>
                  <span class="legend-row"><span>RCE</span><strong>11%</strong></span>
                  <span class="legend-row"><span>Bot</span><strong>7%</strong></span>
                  <span class="legend-row"><span>Other</span><strong>6%</strong></span>
                </div>
              </div>
            </section>
          </div>

          <section class="panel" id="alerts">
            <div class="table-head">
              <h3>Recent Alerts</h3>
              <a class="accent" href="/dashboard">View all alerts →</a>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Time</th>
                    <th>Method</th>
                    <th>URL</th>
                    <th>Client IP</th>
                    <th>Country</th>
                    <th>Status</th>
                    <th>Rule</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  {% for alert in alerts %}
                  <tr>
                    <td>{{ alert.time }}</td>
                    <td>{{ alert.method }}</td>
                    <td>{{ alert.url }}</td>
                    <td>{{ alert.ip }}</td>
                    <td>{{ alert.country }}</td>
                    <td>{{ alert.status }}</td>
                    <td><span class="badge-status {{ alert.severity_class }}">{{ alert.rule }}</span></td>
                    {% if alert.action == "Allowed" %}
                    <td class="action-allowed">{{ alert.action }}</td>
                    {% else %}
                    <td class="action-blocked">{{ alert.action }}</td>
                    {% endif %}
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </section>
        </div>
      </aside>
    </section>

    <section class="home-sections">
      <div class="section-head" id="features">
        <div>
          <h2>Security modules</h2>
          <p class="lead">Composable UI cards for WAF controls, observability, rules and rate limiting.</p>
        </div>
      </div>

      <div class="feature-grid">
        {% for feature in features %}
        <article class="feature-card">
          <span class="card-icon" aria-hidden="true">
            {% if feature.icon == "inspect" %}⌕{% endif %}
            {% if feature.icon == "shield" %}⬡{% endif %}
            {% if feature.icon == "warning" %}⚠{% endif %}
            {% if feature.icon == "audit" %}▤{% endif %}
            {% if feature.icon == "rules" %}&lt;&gt;{% endif %}
            {% if feature.icon == "speed" %}◴{% endif %}
          </span>
          <h3>{{ feature.title }}</h3>
          <p>{{ feature.body }}</p>
        </article>
        {% endfor %}
      </div>

      <section class="section-head">
        <div>
          <h2>Live Overview</h2>
          <p class="lead">Real-time traffic and security metrics.</p>
        </div>
        <button class="ghost-button" type="button">◷ Last 15 minutes</button>
      </section>

      <div class="metric-grid">
        <article class="metric-card">
          <h3>Requests/sec</h3>
          <div class="metric-value"><strong data-live-requests>2,842</strong><span>↑ 18.7%</span></div>
          <div class="mini-chart" data-chart="requests"></div>
        </article>
        <article class="metric-card">
          <h3>Blocked Requests</h3>
          <div class="metric-value"><strong data-live-blocked>482</strong><span class="negative">↑ 32.4%</span></div>
          <div class="mini-chart" data-chart="blocked"></div>
        </article>
        <article class="metric-card">
          <h3>Allowed Requests</h3>
          <div class="metric-value"><strong data-live-allowed>18,392</strong><span>↑ 12.1%</span></div>
          <div class="mini-chart" data-chart="allowed"></div>
        </article>
        <article class="metric-card">
          <h3>Error Rate</h3>
          <div class="metric-value"><strong data-live-error>1.23%</strong><span class="negative">↑ 0.35%</span></div>
          <div class="mini-chart" data-chart="errors"></div>
        </article>
      </div>

      <section class="benefit-strip" aria-label="Platform benefits">
        <article class="benefit"><span class="footer-icon">ϟ</span><div><h3>Built with Rust</h3><p>Blazing fast, memory safe, and built for scale.</p></div></article>
        <article class="benefit"><span class="footer-icon">◴</span><div><h3>High Performance</h3><p>Low latency inspection with minimal overhead.</p></div></article>
        <article class="benefit"><span class="footer-icon">⬡</span><div><h3>Always On</h3><p>Real-time protection with 99.99% uptime.</p></div></article>
        <article class="benefit"><span class="footer-icon">✣</span><div><h3>Easy Integration</h3><p>Reverse proxy mode and APIs to deploy anywhere.</p></div></article>
        <article class="benefit"><span class="footer-icon">&lt;&gt;</span><div><h3>Open & Transparent</h3><p>Auditable, community driven and security focused.</p></div></article>
        <div class="ready"><strong>Ready to secure your apps?</strong><p>Deploy KrakenWaf in minutes.</p><a class="cta" href="/dashboard">Get Started →</a></div>
      </section>
    </section>
  </main>
</div>
</body>
</html>
