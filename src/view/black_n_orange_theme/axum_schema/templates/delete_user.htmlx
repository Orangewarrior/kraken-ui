<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>{{ product_name }} — Delete User</title>
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/app.js" defer></script>
</head>
<body class="auth-page admin-form-page" data-page="acl-form">
  <main class="auth-shell form-only-shell" aria-labelledby="page-title">
    <section class="auth-visual" aria-hidden="true">
      <img class="auth-logo-watermark" src="/static/img/logo-mark.png" width="140" height="140" alt="" decoding="async">
      <div class="auth-orbit"></div>
      <div class="auth-gridlines"></div>
    </section>
    <section class="auth-card form-card">
      <a class="brand auth-brand" href="/acl"><img class="brand-mark-img" src="/static/img/logo-mark.png" width="40" height="40" alt="" aria-hidden="true" decoding="async"><span class="brand-text">Kraken<span>Waf</span></span></a>

      <div class="auth-heading"><span class="badge danger-badge">Destructive ACL Action</span><h1 id="page-title">Delete <span class="accent">user</span></h1><p class="lead">Delete a user by ID or e-mail. Backend should require admin authorization, CSRF, and audit logging.</p></div>
      <form class="login-form management-form" method="post" action="/acl/users/delete" autocomplete="off">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <div class="field-group"><label for="user_id">User ID</label><input id="user_id" name="user_id" type="number" inputmode="numeric" min="1" placeholder="42" value="{{ user_id }}"></div>
        <div class="form-separator"><span>or</span></div>
        <div class="field-group"><label for="email">E-mail</label><input id="email" name="email" type="email" autocomplete="off" placeholder="user@example.local" value="{{ email }}" maxlength="254"></div>
        <button class="cta submit-button danger-button" type="submit">Submit delete request →</button>
      </form>
      <div class="auth-note" role="note"><strong>Backend note:</strong> this template performs client-side validation only for UX. Enforce password policy, CSRF, authorization, and audit logging server-side.</div>
    </section>
  </main>
</body>
</html>
