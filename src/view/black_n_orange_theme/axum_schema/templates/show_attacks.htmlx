<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>{{ product_name }} — Attacks</title>
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/app.js" defer></script>
</head>
<body data-page="attacks">
<header class="mobile-topbar"><a class="brand" href="/"><img class="brand-mark-img" src="/static/img/logo-mark.png" width="40" height="40" alt="" aria-hidden="true" decoding="async"><span class="brand-text">Kraken<span>Waf</span></span></a><button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-label="Open navigation">☰</button></header>
<div class="shell"><aside class="sidebar" aria-label="Primary navigation"><a class="brand" href="/"><img class="brand-mark-img" src="/static/img/logo-mark.png" width="40" height="40" alt="" aria-hidden="true" decoding="async"><span class="brand-text">Kraken<span>Waf</span></span></a><nav class="nav"><div class="nav-section"><a class="nav-link" href="/dashboard"><span class="nav-icon" aria-hidden="true">▦</span><strong>Dashboard</strong></a></div><div class="nav-section"><a class="nav-link" href="/acl"><span class="nav-icon" aria-hidden="true">⬡</span><strong>ACL control</strong></a></div><div class="nav-section"><button class="nav-trigger active" type="button" data-accordion aria-expanded="true" aria-controls="logs-menu"><span class="nav-icon" aria-hidden="true">▤</span><strong>logs</strong><span class="chevron" aria-hidden="true">⌄</span></button><div class="submenu" id="logs-menu"><a href="/attacks">attacks</a><a href="/dashboard#requests">requests</a><a href="/dashboard#audit">audit</a></div></div><div class="nav-section"><a class="nav-link" href="/login"><span class="nav-icon" aria-hidden="true">⏻</span><strong>logout</strong></a></div></nav></aside>
<main class="content table-page"><section class="page-hero compact-hero"><span class="badge">Attack Evidence</span><h1>Observed WAF attacks</h1><p class="lead">Search attacks and open evidence in a new tab with dark syntax highlighting.</p></section>
<section class="table-card" aria-labelledby="attacks-title"><div class="table-toolbar"><div><h2 id="attacks-title">Attacks</h2><p>Server-side endpoint: <code>/api/attacks</code></p></div><label class="table-search"><span>Search</span><input type="search" data-kw-table-search="attacks-table" placeholder="IP, rule, method, URL" autocomplete="off"></label></div><div class="table-scroll"><table id="attacks-table" class="kw-table" data-kw-table data-table-kind="attacks" data-ajax-url="/api/attacks" data-server-side="true" data-page-size="8"><thead><tr><th>ID</th><th>Time</th><th>IP</th><th>Method</th><th>URL</th><th>Rule</th><th>Severity</th><th>Action</th><th>View</th></tr></thead><tbody></tbody></table></div><div class="table-footer"><button type="button" class="ghost-button" data-kw-table-prev="attacks-table">Previous</button><span data-kw-table-info="attacks-table">Loading…</span><button type="button" class="ghost-button" data-kw-table-next="attacks-table">Next</button></div></section></main></div></body></html>
