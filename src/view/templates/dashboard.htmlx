<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title>KrakenWAF - Dashboard</title><link rel="stylesheet" href="/static/style.css"><script src="/static/app.js" defer></script></head>
<body data-page="dashboard"><div class="shell admin-shell">{% include "admin_sidebar.html" %}<main class="page dashboard-page admin-content">
  <header class="dashboard-toolbar"><div><span class="badge">WAF observability</span><h1>Dashboard</h1><p class="lead">HTTPS metrics and SQLite aggregations from KrakenWAF.</p></div><a class="ghost-button" href="/kraken_ui/auth/dashboard">Refresh</a></header>
  <p class="form-message error" data-dashboard-error hidden></p>
  <section class="metric-grid" data-dashboard-metrics><article class="metric-card"><h3>Requests inspected</h3><strong data-metric="requests_inspected">0</strong></article><article class="metric-card"><h3>Requests blocked</h3><strong data-metric="requests_blocked">0</strong></article><article class="metric-card"><h3>Rate limit hits</h3><strong data-metric="rate_limit_hits">0</strong></article><article class="metric-card"><h3>Average latency</h3><strong data-metric="average_latency">0 ms</strong></article><article class="metric-card"><h3>Redis fail-open</h3><strong data-metric="redis_failopen">0</strong></article><article class="metric-card"><h3>Redis fail-closed</h3><strong data-metric="redis_failclosed">0</strong></article><article class="metric-card"><h3>Trace forwarded</h3><strong data-metric="trace_forwarded">0</strong></article><article class="metric-card"><h3>Trace generated</h3><strong data-metric="trace_generated">0</strong></article></section>
  <section class="dashboard-grid"><article class="panel"><h2>Detections per CMC module</h2><div class="svg-chart" data-cmc-pie aria-label="Pie chart of CMC modules"></div><div class="chart-legend" data-cmc-legend></div></article><article class="panel"><h2>Blocks per module</h2><div class="svg-chart wide" data-module-bars aria-label="Bar chart of blocks per module"></div></article></section>
  <section class="dashboard-grid"><article class="panel"><h2>Top blocking countries</h2><div class="rank-list" data-country-rank></div></article><article class="panel"><h2>Top blocking IPs</h2><div class="rank-list" data-ip-rank></div></article></section>
</main></div></body></html>
