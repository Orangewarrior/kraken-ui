<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>KrakenWAF - WAF request #{{ attack_id }}</title>
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/app.js" defer></script>
</head>
<body class="waf-request-page" data-page="waf-request">
  <main class="waf-request-shell">
    <article class="waf-request-card">
      <p><strong>Title:</strong> {{ title }}</p>
      <p><strong>Severity:</strong> <span class="waf-severity {{ severity_class }}">{{ severity }}</span></p>
      <p><strong>CWE:</strong> {{ cwe }}</p>
      <p><strong>Description:</strong> {{ description }}</p>
      <p><strong>Reference:</strong> {{ reference_url }}</p>
      <p><strong>Ocurred at:</strong> {{ occurred_at }}</p>
      <p><strong>Rule match:</strong> {{ rule_match }}</p>
      <p><strong>Rule_line_match:</strong> {{ rule_line_match }}</p>
      <p><strong>client ip addr:</strong> {{ client_ip }}</p>
      <p><strong>Uri:</strong> {{ request_uri }}</p>
      <p><strong>Fullpath evidence:</strong> {{ fullpath_evidence }}</p>
      <p><strong>Request_payload:</strong></p>
      <pre class="waf-code-window"><code data-waf-payload>{{ request_payload }}</code></pre>
    </article>
  </main>
</body>
</html>
