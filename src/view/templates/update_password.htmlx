<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title>KrakenWAF - Change password</title><link rel="stylesheet" href="/static/style.css"><script src="/static/app.js" defer></script></head>
<body data-page="password"><div class="shell admin-shell">{% include "admin_sidebar.html" %}<main class="page admin-content">
  <section class="page-hero compact-hero"><span class="badge">User status</span><h1>Change password</h1></section>
  <section class="panel form-panel">
    {% if message != "" %}<p class="form-message {{ message_class }}" role="status">{{ message }}</p>{% endif %}
    {% if show_form %}
    <form class="login-form management-form" method="post" action="/kraken_ui/auth/update_password_action" data-password-policy>
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}"><input type="hidden" name="id_user" value="{{ id_user }}"><input type="hidden" id="username" value="{{ username }}"><input type="hidden" id="email" value="{{ email }}">
      <div class="field-group"><label for="password">Nova password</label><input id="password" name="password" type="password" required minlength="14" maxlength="256" data-strong-password><span data-password-strength>Strength: waiting</span><ul class="password-rules" data-password-rules><li data-rule="length">Exemplo: Mais-De-14!Caracteres9</li><li data-rule="lower">Letra minuscula</li><li data-rule="upper">Letra maiuscula</li><li data-rule="digit">Numero</li><li data-rule="symbol">Simbolo</li><li data-rule="identity">Nao use username ou e-mail</li></ul></div>
      <button class="cta" type="submit" data-policy-submit disabled>Trocar password</button>
    </form>
    {% endif %}
  </section>
</main></div></body></html>
